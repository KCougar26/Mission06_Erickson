@model List<Movie>

<div class="container mt-4">
    <h2 class="mb-4">Joel's Movie Collection</h2>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Plex</th>
            <th></th> <th></th> </tr>
        </thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Title</td>
                <td>@(m.Category?.CategoryName ?? "N/A")</td>
                <td>@m.Year</td>
                <td>@m.Director</td>
                <td>@m.Rating</td>
                <td>@(m.Edited ? "Yes" : "No")</td>
                <td>@(m.CopiedToPlex ? "Yes" : "No")</td>
                    
                @* Edit Button *@
                <td>
                    <a class="btn btn-sm btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@m.MovieId">Edit</a>
                </td>
                    
                @* Delete Button *@
                <td>
                    <a class="btn btn-sm btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@m.MovieId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    
    <a class="btn btn-primary" asp-action="AddMovie">Add New Movie</a>
</div>